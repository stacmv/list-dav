# ListDAV Configuration

# Application
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# Authentication
AUTH_DRIVER=basic
AUTH_REALM="ListDAV"

# Database
DB_PATH=var/data/listdav.sqlite

# YouTube Module
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=${APP_URL}/ui/oauth/youtube/callback

# Cache
CACHE_TTL=300

# Trash
TRASH_RETENTION_DAYS=30
